# Use a newly generated Stripe TEST secret key for local development.
# Never put a Stripe secret key in client code or commit .env.local.
STRIPE_SECRET_KEY=sk_test_replace_with_a_rotated_test_key

# The public key is not required because the app redirects to Stripe Checkout.
# Keep this value on the server only if a later Stripe Elements integration needs it.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_matching_test_key

# Required for the Vercel deployment callback URLs only.
APP_URL=https://your-production-domain.example

# Required before deploying the webhook endpoint.
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
